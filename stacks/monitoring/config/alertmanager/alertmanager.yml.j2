# {{ ansible_managed }}
route:
  receiver: {{ 'telegram' if telegram_bot_token is defined else 'none' }}
  group_by: [alertname, host]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: none
{% if telegram_bot_token is defined %}
  - name: telegram
    telegram_configs:
      - bot_token: "{{ telegram_bot_token }}"
        chat_id: {{ telegram_chat_id | int }}
        send_resolved: true
{% endif %}
