# {{ ansible_managed }}
TZ={{ homelab_timezone }}
LOCAL_DOMAIN={{ homelab_local_domain }}
GF_SECURITY_ADMIN_USER=admin
GF_SERVER_ROOT_URL=https://grafana.{{ homelab_local_domain }}
GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
{% if pve_exporter_token_value is defined %}
COMPOSE_PROFILES=pve
PVE_USER=pve-exporter@pve
PVE_TOKEN_NAME=monitoring
PVE_TOKEN_VALUE={{ pve_exporter_token_value }}
PVE_VERIFY_SSL=false
{% endif %}
