# {{ ansible_managed }}
TZ={{ homelab_timezone }}
LOCAL_DOMAIN={{ homelab_local_domain }}
FORGE_VERSION={{ forge_version[:12] }}
FORGE_UID={{ forge_uid }}
FORGE_PUBLIC_URL=https://forge.{{ homelab_public_domain }}
POSTGRES_DB=forge
POSTGRES_USER=forge_user
POSTGRES_PASSWORD={{ (forge_postgres_password | default('')) | replace('$', '$$') }}
JWT_SECRET={{ (forge_jwt_secret | default('')) | replace('$', '$$') }}
