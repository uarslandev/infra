# {{ ansible_managed }}
TZ={{ homelab_timezone }}
LOCAL_DOMAIN={{ homelab_local_domain }}
APEX_VERSION={{ apex_version[:12] }}
APEX_UID={{ apex_uid }}
APEX_SMTP_HOST={{ apex_smtp_host }}
APEX_SMTP_PORT={{ apex_smtp_port }}
APEX_SMTP_USERNAME={{ apex_smtp_username }}
APEX_SMTP_PASSWORD={{ (apex_smtp_password | default('')) | replace('$', '$$') }}
APEX_MAIL_FROM={{ apex_mail_from }}
APEX_APP_URL={{ apex_app_url }}
